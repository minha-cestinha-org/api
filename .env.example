# Copie para .env e ajuste. Nunca commite o .env.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
DB_URL=jdbc:postgresql://localhost:5432/minhacestinha
DB_USER=postgres
DB_PASSWORD=postgres
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
# Opcionais: sem elas, o nome do produto fica a descrição da nota em minúsculo
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
COSMOS_TOKEN=
# SMTP pro código de redefinição de senha (sem MAIL_HOST, não envia)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=minhacestinha <nao-responda@minhacestinha.com.br>
